# Application Settings
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Subscription Manager"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Security & JWT
# IMPORTANT: Generate a secure 32+ character random secret in production
SECRET_KEY=change_this_to_a_super_secret_cryptographic_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Cookie Configuration
COOKIE_NAME=access_token
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
COOKIE_HTTPONLY=True

# Database Configuration (PostgreSQL 16+)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/subscription_manager
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis & Background Workers
REDIS_URL=redis://localhost:6379/0

# Seed: Reference Tenant
INITIAL_TENANT_NAME="Brightloop Software"
INITIAL_TENANT_SLUG="brightloop-software"

# Seed: First Admin Credentials
FIRST_ADMIN_EMAIL=admin@brightloop.io
FIRST_ADMIN_PASSWORD=Admin@Brightloop123
FIRST_ADMIN_NAME="Brightloop Admin"

# Development Simulation Flags
ENABLE_DEV_PASSWORD_RESET_SIMULATION=True

